    {
      "name": "Carga manual",
      "item": [
        {
          "name": "Subir imagen PNG o JPEG de hasta 2 MB",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/upload",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "imagen",
                  "type": "file",
                  "src": []
