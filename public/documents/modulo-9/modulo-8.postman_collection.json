{
  "info": {
    "name": "Módulo 8 - Usuarios y pedidos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecuta Flujo completo en orden. Usa una cuenta temporal y la elimina al final. Para probar imágenes, ejecuta registro/login y selecciona un archivo en la carpeta Carga manual antes de eliminar la cuenta."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "usuario_id",
      "value": ""
    },
    {
      "key": "pedido_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Flujo completo",
      "item": [
        {
          "name": "01 - Ruta protegida sin token",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/usuarios",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
                  "const body = pm.response.json();",
                  "pm.test('Formato consistente', () => pm.expect(body).to.have.all.keys('status', 'message', 'data'));",
                  "pm.test('Sin contraseña expuesta', () => pm.expect(pm.response.text()).not.to.include('\"password\"'));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('email', `prueba.${Date.now()}@example.test`);",
                  "pm.collectionVariables.set('token', '');"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Registrar cuenta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/registro",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ana Postman\",\n  \"email\": \"{{email}}\",\n  \"password\": \"ClaveEjemplo123\",\n  \"biografia\": \"Prueba del módulo 8\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Formato consistente', () => pm.expect(body).to.have.all.keys('status', 'message', 'data'));",
                  "pm.test('Sin contraseña expuesta', () => pm.expect(pm.response.text()).not.to.include('\"password\"'));",
                  "pm.collectionVariables.set('usuario_id', body.data.id);"
                ]
              }
            }
          ]
        },
