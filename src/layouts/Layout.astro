---
import { withBase } from "../utils/paths";
import "../styles/global.css";
interface Props {
  title: string;
}
const { title } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const description =
  "Soy Francisco Meza Dastres, ingeniero informático en Santiago de Chile. Desarrollo experiencias web con React, TypeScript y Node.js.";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#16141c" />
    <link
      rel="icon"
      type="image/x-icon"
      href={withBase("/favicon.ico?v=shield-1")}
      sizes="16x16 32x32 48x48"
    />
    <link
      rel="icon"
      type="image/png"
      href={withBase("/favicon-32.png?v=shield-1")}
      sizes="32x32"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href={withBase("/brand/portfolio-shield.svg")}
      sizes="any"
    />
    <link
      rel="apple-touch-icon"
      href={withBase("/apple-touch-icon.png?v=shield-1")}
      sizes="180x180"
    />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta
      property="og:url"
      content={canonical}
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta
      property="og:image"
      content={new URL(withBase("blackmichiestudio.png"), Astro.site).href}
    />
    <title>{title}</title>
  </head>
  <body><a class="skip-link" href="#main">Saltar al contenido</a><slot /></body>
</html>
