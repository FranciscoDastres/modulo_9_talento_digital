---
import { withBase } from "../utils/paths";
import Layout from "../layouts/Layout.astro";
import Footer from "../components/footer.astro";
import profile from "../data/professional-profile.json";
---

<Layout title="Proyección profesional y FODA | Francisco Meza Dastres">
  <header class="profile-nav wrap">
    <a href={withBase("/")} aria-label="Volver al portafolio"><img src={withBase("/brand/portfolio-shield.svg")} width="34" height="34" alt="" />Francisco Meza Dastres</a>
    <a href={withBase("/#formacion")}>Proyectos del curso</a>
  </header>
  <main id="main" class="profile-page wrap">
    <section class="profile-intro" aria-labelledby="profile-title">
      <h1 id="profile-title">Lo que puedo aportar.<br />Lo que quiero aprender.</h1>
      <p>{profile.summary}</p>
      <nav class="profile-toc" aria-label="Secciones del perfil"><a href="#empresa">Empresa elegida</a><a href="#aportes">Mis aportes</a><a href="#foda">Matriz FODA</a><a href="#documentos">Documentos y contacto</a></nav>
    </section>
    <section id="empresa" aria-labelledby="company-title">
      <h2 id="company-title">Por qué {profile.company.name}</h2>
      <p class="lead">{profile.company.reason}</p>
      <div class="table-scroll" role="region" aria-label="Investigación de Mercado Libre" tabindex="0">
        <table>
          <caption>Investigación de empresa y conexión con mi perfil</caption>
          <thead><tr><th scope="col">Aspecto</th><th scope="col">Qué encontré</th><th scope="col">Qué me atrae técnicamente</th></tr></thead>
          <tbody>{profile.company.rows.map(row => <tr><th scope="row">{row.aspect}</th><td>{row.finding}<span class="source-links">{row.sources.map(id => <a href={`#fuente-${id}`} aria-label={`Consultar fuente ${id}`}>[{id}]</a>)}</span></td><td>{row.interest}</td></tr>)}</tbody>
        </table>
      </div>
      <p class="small-note">La investigación usa fuentes públicas. Las prácticas descritas pueden variar entre equipos; no corresponden a una oferta laboral confirmada.</p>
    </section>
    <section id="aportes" aria-labelledby="contribution-title">
      <h2 id="contribution-title">Tres aportes concretos</h2>
      <div class="contributions">{profile.company.contributions.map(item => <article><h3>{item.title}</h3><p>{item.text}</p><p class="evidence"><strong>Evidencia en mi portafolio:</strong> {item.evidence}</p></article>)}</div>
      <h3 class="interview-title">Preguntas para la entrevista</h3>
      <ol class="questions">{profile.company.questions.map(question => <li>{question}</li>)}</ol>
    </section>
    <section id="foda" aria-labelledby="foda-title">
      <h2 id="foda-title">Mi matriz FODA</h2>
      <p class="lead">Una autoevaluación para orientar mi siguiente etapa como desarrollador. Cinco puntos por categoría y acciones para avanzar.</p>
      <div class="foda-grid">{profile.foda.map(group => <article><h3>{group.title}</h3><p class="origin">{group.origin}</p><ul>{group.items.map(item => <li>{item}</li>)}</ul></article>)}</div>
      <p class="small-note">{profile.marketNote} <a href="#fuente-4">[4]</a></p>
      <h3 class="interview-title">Cómo voy a trabajar estas áreas</h3>
      <ol class="questions">{profile.actionPlan.map(action => <li>{action}</li>)}</ol>
    </section>
    <section id="documentos" aria-labelledby="documents-title">
      <h2 id="documents-title">Documentos y contacto</h2>
      <div class="downloads"><a class="button button-light" href={withBase("/documents/modulo-9/proyecto-modulo-9-francisco-meza-dastres.pdf")} download>Descargar proyecto (PDF)</a><a class="button button-outline" href={withBase("/documents/modulo-9/cv-francisco-meza-dastres.pdf")} download>Descargar CV (PDF)</a></div>
      <div class="contact-links"><a href={`mailto:${profile.email}`}>{profile.email}</a><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a><a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub</a><a href={withBase("/#caso-de-estudio")}>Leer el caso de estudio</a></div>
    </section>
    <section class="sources" aria-labelledby="sources-title"><h2 id="sources-title">Fuentes de la investigación</h2><p class="small-note">Consulta: {profile.date}. Los artículos técnicos describen el enfoque publicado por su equipo en 2024.</p><ol>{profile.sources.map(source => <li id={`fuente-${source.id}`}><a href={source.url} target="_blank" rel="noopener noreferrer">{source.title}</a></li>)}</ol></section>
  </main>
  <Footer />
</Layout>

<style>
  .profile-nav { display: flex; justify-content: space-between; align-items: center; gap: 25px; padding-block: 25px; font-size: 14px; }
  .profile-nav > a:first-child { display: flex; align-items: center; gap: 12px; }
  .profile-nav > a:last-child { color: var(--accent); }
  .profile-page { max-width: 1180px; }
  .profile-intro { padding-block: 60px 75px; }
  h1 { font-size: clamp(38px, 5.4vw, 72px); line-height: 1.12; letter-spacing: -.045em; font-weight: 500; }
  .profile-intro > p { max-width: 790px; margin-block: 30px; color: var(--muted); font-size: 18px; }
  .profile-toc { display: flex; flex-wrap: wrap; gap: 16px 28px; color: var(--accent); font-size: 14px; }
  .profile-page > section:not(.profile-intro) { padding-block: 55px; border-top: 1px solid var(--line); }
  h2 { font-size: clamp(30px, 3.2vw, 44px); letter-spacing: -.035em; }
  h3 { font-size: 22px; font-weight: 500; line-height: 1.4; }
  .lead { color: var(--muted); max-width: 800px; margin-block: 24px 30px; }
  .table-scroll { overflow-x: auto; margin-bottom: 20px; }
  table { width: 100%; border-collapse: collapse; font-size: 14px; text-align: left; }
  caption { text-align: left; color: var(--muted); font-size: 13px; padding-bottom: 16px; }
  th, td { padding: 20px; vertical-align: top; border-bottom: 1px solid var(--line); line-height: 1.7; }
  thead { background: var(--surface); }
  th { font-weight: 500; }
  td { color: var(--muted); }
  tbody th { width: 19%; padding-left: 0; }
  td { width: 40.5%; }
  .source-links { display: flex; gap: 8px; margin-top: 8px; color: var(--accent); }
  .small-note { color: var(--muted); font-size: 13px; max-width: 850px; }
  .contributions { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; margin-top: 35px; }
  .contributions p { font-size: 14px; color: var(--muted); margin-top: 16px; }
  .contributions .evidence { border-top: 1px solid var(--line); padding-top: 16px; font-size: 13px; }
  .interview-title { margin-top: 35px; }
  .questions { max-width: 850px; padding-left: 22px; color: var(--muted); }
  .questions li { padding-left: 8px; margin-top: 16px; line-height: 1.7; }
  .foda-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 40px; margin-block: 30px; }
  .foda-grid article { background: var(--surface); padding: 28px; border-radius: 8px; }
  .origin { color: var(--accent); font-size: 13px; margin-top: 7px; }
  .foda-grid ul { padding-left: 18px; color: var(--muted); font-size: 14px; }
  .foda-grid li { padding-left: 5px; margin-top: 14px; line-height: 1.7; }
  .downloads, .contact-links { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 30px; }
  .contact-links { color: var(--accent); font-size: 14px; overflow-wrap: anywhere; }
  .sources h2 { font-size: 26px; margin-bottom: 20px; }
  .sources ol { padding-left: 22px; }
  .sources li { color: var(--accent); font-size: 14px; margin-top: 16px; line-height: 1.7; scroll-margin-top: 30px; }
  @media (max-width: 700px) {
    .profile-nav { font-size: 12px; align-items: flex-start; }
    .profile-nav > a:last-child { text-align: right; }
    .profile-intro { padding-block: 35px 45px; }
    .profile-intro > p { font-size: 15px; }
    .contributions, .foda-grid { grid-template-columns: 1fr; }
    .profile-page > section:not(.profile-intro) { padding-block: 40px; }
    table { min-width: 670px; }
    th, td { padding: 16px; }
    .foda-grid article { padding: 22px; }
    .downloads .button { font-size: 14px; }
  }
</style>
