---
import Layout from "../../../layouts/Layout.astro";
import { withBase } from "../../../utils/paths";
import records from "../../../data/api-responses.json";
const codes = [...new Set(records.map(record => record.codigo))].sort();
---

<Layout title="Explorar la API de usuarios y pedidos | Francisco Meza Dastres">
  <header class="api-nav wrap"><a href={withBase("/#formacion")}>Volver al portafolio</a><a href={withBase("/#caso-de-estudio")}>Leer el caso de estudio</a></header>
  <main id="main" class="api-demo wrap">
    <h1>Una API, vista desde sus respuestas.</h1>
    <p class="intro">Explora {records.length} solicitudes registradas durante las pruebas de la API de usuarios y pedidos: autenticación, CRUD, permisos y validaciones.</p>
    <p class="recording-note">Este visor muestra respuestas reales de una ejecución local. Aquí no se ejecuta el servidor Express ni se conecta PostgreSQL. Las solicitudes no se envían de nuevo y los tokens están omitidos.</p>
    <div class="api-explorer">
      <section aria-label="Solicitudes disponibles">
        <div class="filters"><label>Método<select id="method-filter"><option value="">Todos</option>{["GET", "POST", "PUT", "DELETE"].map(method => <option>{method}</option>)}</select></label><label>Código HTTP<select id="code-filter"><option value="">Todos</option>{codes.map(code => <option>{code}</option>)}</select></label></div>
        <p id="request-count" class="request-count" role="status">{records.length} solicitudes</p>
        <div class="requests" id="request-list">{records.map((record, index) => <button type="button" data-index={index} data-method={record.metodo} data-code={record.codigo} aria-pressed={index === 0 ? "true" : "false"}><span class="method">{record.metodo}</span><span class="route">{record.ruta}</span><span class:list={["code", { success: record.codigo < 400 }]}>{record.codigo}</span></button>)}</div>
      </section>
      <section class="response" aria-labelledby="response-title"><h2 id="response-title">{records[0].metodo} {records[0].ruta}</h2><p id="response-summary">Código {records[0].codigo} · {records[0].autenticado ? "Solicitud con token" : "Solicitud sin token"}</p><pre id="response-body">{JSON.stringify(records[0].respuesta, null, 2)}</pre><button type="button" class="button button-outline" id="copy-response">Copiar respuesta JSON</button><p id="copy-status" role="status"></p></section>
    </div>
    <nav class="api-resources" aria-label="Documentación del proyecto"><a href={withBase("/documents/modulo-9/modulo-8.postman_collection.json")} download>Descargar colección de Postman</a><a href="https://github.com/FranciscoDastres/prueba_modulo_8" target="_blank" rel="noopener noreferrer">Código e instrucciones del servidor</a><a href={withBase("/demos/alke-wallet/login.html")}>Probar Alke Wallet</a></nav>
  </main>
  <script type="application/json" id="api-evidence" set:html={JSON.stringify(records).replace(/</g, "\\u003c")} />
</Layout>

<script>
  interface RecordEntry { metodo: string; ruta: string; codigo: number; autenticado: boolean; respuesta: unknown }
  const records: RecordEntry[] = JSON.parse(document.getElementById("api-evidence")!.textContent!);
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("#request-list button"));
  const method = document.querySelector<HTMLSelectElement>("#method-filter")!;
  const code = document.querySelector<HTMLSelectElement>("#code-filter")!;
  const body = document.getElementById("response-body")!;
  let selected = 0;
  function selectRequest(index: number) {
    selected = index;
    const record = records[index];
    document.getElementById("response-title")!.textContent = `${record.metodo} ${record.ruta}`;
    document.getElementById("response-summary")!.textContent = `Código ${record.codigo} · ${record.autenticado ? "Solicitud con token" : "Solicitud sin token"}`;
    body.textContent = JSON.stringify(record.respuesta, null, 2);
    document.getElementById("copy-status")!.textContent = "";
    buttons.forEach(button => button.setAttribute("aria-pressed", String(Number(button.dataset.index) === index)));
  }
  buttons.forEach(button => button.addEventListener("click", () => selectRequest(Number(button.dataset.index))));
  function filterRequests() {
    const visible = buttons.filter(button => {
      button.hidden = Boolean((method.value && button.dataset.method !== method.value) || (code.value && button.dataset.code !== code.value));
      return !button.hidden;
    });
    document.getElementById("request-count")!.textContent = `${visible.length} solicitudes`;
    if (visible.length && buttons[selected].hidden) selectRequest(Number(visible[0].dataset.index));
    document.querySelector<HTMLElement>(".response")!.hidden = !visible.length;
  }
  method.addEventListener("change", filterRequests);
  code.addEventListener("change", filterRequests);
  document.getElementById("copy-response")!.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(body.textContent!);
      document.getElementById("copy-status")!.textContent = "Respuesta copiada.";
    } catch {
      document.getElementById("copy-status")!.textContent = "Selecciona el texto de la respuesta para copiarlo.";
    }
  });
</script>

<style>
  .api-nav { display: flex; justify-content: space-between; gap: 20px; padding-block: 28px; font-size: 14px; color: var(--accent); }
  .api-demo { max-width: 1180px; padding-block: 45px 70px; }
  h1 { font-size: clamp(34px, 4.5vw, 62px); line-height: 1.12; letter-spacing: -.035em; font-weight: 500; max-width: 800px; }
  .intro { max-width: 750px; color: var(--muted); margin-block: 24px; }
  .recording-note { font-size: 13px; color: var(--muted); max-width: 850px; border-left: 3px solid var(--accent); padding-left: 18px; }
  .api-explorer { display: grid; grid-template-columns: 1fr 1.25fr; gap: 30px; margin-top: 40px; align-items: start; }
  .filters { display: flex; gap: 15px; }
  .filters label { flex: 1; font-size: 13px; min-width: 0; }
  select { display: block; width: 100%; margin-top: 8px; padding: 10px; background: var(--surface); color: var(--text); border: 1px solid var(--line); border-radius: 4px; }
  .request-count { margin-block: 16px; color: var(--muted); font-size: 13px; }
  .requests { max-height: 540px; overflow-y: auto; border-block: 1px solid var(--line); }
  .requests button { width: 100%; display: flex; align-items: center; gap: 12px; padding: 16px 12px; border: 0; border-bottom: 1px solid var(--line); background: transparent; text-align: left; font-size: 13px; }
  .requests button[hidden] { display: none; }
  .requests button[aria-pressed="true"] { background: var(--surface); box-shadow: inset 3px 0 var(--accent); }
  .method { flex: 0 0 52px; color: var(--accent); }
  .route { min-width: 0; flex: 1; overflow-wrap: anywhere; }
  .code { color: #efb7c4; }
  .code.success { color: #b8dbc2; }
  .response { min-width: 0; background: var(--surface); padding: 28px; border-radius: 8px; }
  .response h2 { font-size: 24px; overflow-wrap: anywhere; letter-spacing: -.02em; }
  #response-summary { font-size: 13px; color: var(--muted); margin-block: 15px; }
  pre { white-space: pre-wrap; overflow-wrap: anywhere; font-size: 13px; line-height: 1.75; margin-block: 25px; }
  #copy-status { font-size: 13px; margin-top: 12px; color: var(--accent); }
  .api-resources { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 35px; color: var(--accent); font-size: 14px; }
  @media (max-width: 700px) { .api-explorer { grid-template-columns: 1fr; } .requests { max-height: 300px; } .response { padding: 22px; } .api-nav { font-size: 12px; } }
</style>
