---
import { Image } from "astro:assets";
import { projects } from "../data/projects";
import { projectDetails } from "../data/project-details";
---

<section class="project-list wrap" aria-labelledby="project-list-title">
  <div class="section-heading">
    <h2 id="project-list-title">Mis proyectos.</h2><p>
      Una vista de cada producto,<br />a tu ritmo.
    </p>
  </div>
  <ul class="project-catalog">
    {
      projects.map((project, i) => (
        <li>
          <article
            class="project-list-item"
            aria-labelledby={`catalog-title-${i}`}
          >
            <a
              class="project-list-preview"
              href={project.preview}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Abrir ${project.title} en otra pestaña`}
            >
              <>
                <Image
                  src={project.image}
                  alt={`Captura de ${project.title}`}
                  widths={[400, 640, 1000]}
                  sizes="(max-width: 700px) 90vw, 40vw"
                  loading="lazy"
                />
                <span class="preview-action" aria-hidden="true">
                  Visitar proyecto ↗
                </span>
              </>
            </a>
            <div class="project-list-copy">
              <>
                <span class="section-label">{projectDetails[i].category}</span>
                <h3 id={`catalog-title-${i}`}>{project.title}</h3>
                <p>{project.description}</p>
                <ul
                  class="tech-tags"
                  aria-label={`Tecnologías de ${project.title}`}
                >
                  {project.technologies.map((tech) => (
                    <li>{tech}</li>
                  ))}
                </ul>
                <a
                  class="text-link"
                  href={project.preview}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Visitar proyecto{" "}
                  <>
                    <span aria-hidden="true">↗</span>
                    <span class="sr-only"> (se abre en otra pestaña)</span>
                  </>
                </a>
              </>
            </div>
          </article>
        </li>
      ))
    }
  </ul>
</section>
